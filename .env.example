# For local development, use localhost in DATABASE_URL and run PostgreSQL locally.
# Docker Compose builds the container URL from POSTGRES_USER/DB/PASSWORD automatically.
APP_ORIGIN=http://localhost:5173
POSTGRES_USER=orbit
POSTGRES_DB=orbit
# Use a URL-safe password (letters, numbers, hyphens, underscores).
POSTGRES_PASSWORD=replace_with_a_long_random_url_safe_password
DATABASE_URL=postgresql://orbit:replace_with_a_long_random_url_safe_password@localhost:5432/orbit?schema=public
